{
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "module": "ESNext",
    "outDir": "dist",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "rootDir": "./",
    "types": ["node-red", "@keload/node-red-dxp"]
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["./test"]
}
